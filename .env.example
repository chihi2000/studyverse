DATABASE_URL=postgres://studyverse:studyverse@localhost:5434/studyverse
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where uploaded notice photos are stored (mount a volume here in production)
UPLOAD_DIR=./uploads
# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web Push keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Email (password reset, verification) through Resend; without a key, emails are printed to the server log
RESEND_API_KEY=
EMAIL_FROM=Studyverse <noreply@studyverse.devappland.com>
# Extra origins allowed to sign in (comma-separated), e.g. the old vercel.app URL after moving to a custom domain
BETTER_AUTH_TRUSTED_ORIGINS=
